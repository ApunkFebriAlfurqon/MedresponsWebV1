Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /rapidaid/
    RewriteRule ^api/programs/?$ api/programs.php [QSA,L]
    RewriteRule ^api/programs/([0-9]+)/?$ api/programs.php?id=$1 [QSA,L]
</IfModule>

<FilesMatch "\.(sql|log|md)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>
